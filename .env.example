# Copy to .env.local and fill in. Never commit .env.local.
# Vercel: add the same names under Project → Settings → Environment Variables.

ADAPTER_MODE=mock          # mock | real

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=          # speech to text with speaker labels (band listener)
VEXO_API_KEY=              # rename to match the Vexo SDK docs
VEXO_DEVICE_ID=

# Optional signals — keep only what you use
OPENWEATHER_API_KEY=
AIRNOW_API_KEY=
ELEVENLABS_API_KEY=        # or whichever TTS the organizers provide

# Browser-safe values only (these are exposed to the client)
NEXT_PUBLIC_APP_NAME=
