# Recorded conversations, voices, payees (real people): never committed. Everything in data/
# is ignored, so stray copies ("live 2.json") can't slip in; only the sample is shared.
data/*
!data/interactions.sample.json
data/interactions.json
data/*.tmp
data/live.json
*.tsbuildinfo
data/voiceprints.json
data/live_names.jsonl
data/*.taken
data/promises.json
data/recaps/
data/cache/
data/control.json
data/circles.json
data/payees.json
data/orbits.json
